# Database
DATABASE_URL=postgresql://user:password@host:5432/misitioapp

# Auth (mínimo 32 caracteres)
JWT_SECRET=cambiar-por-un-secreto-largo-de-al-menos-32-caracteres

# CORS — orígenes permitidos separados por coma
CORS_ORIGIN=https://admin.appresuelve.com.ar,https://appresuelve.com.ar

# Puerto (opcional, default 3001)
PORT=3001

# Internal — debe coincidir con el APPRESUELVE_SECRET de appresuelve-platform
APPRESUELVE_SECRET=cambiar-por-un-secreto-compartido-con-la-plataforma

# Super admin (opcional)
SUPER_ADMIN_EMAIL=admin@appresuelve.com
SUPER_ADMIN_PASSWORD=cambiar-password

# Frontend — para los links de activación / reset de contraseña
STORE_FRONTEND_URL=https://appresuelve.com.ar

# Email (Brevo)
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=no-reply@appresuelve.com

# Cloudinary (upload de imágenes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_PREFIX=misitioapp

# Plataforma (change requests)
PLATFORM_API_URL=https://api.appresuelve.com.ar
PLATFORM_API_KEY=
WHATSAPP_NOTIFY_NUMBER=
