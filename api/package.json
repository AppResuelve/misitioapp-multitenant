{
  "name": "misitioapp-api",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "pnpm run db:migrate && node src/index.js",
    "seed": "node src/seed/seed.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:status": "sequelize-cli db:migrate:status"
  },
  "dependencies": {
    "@getbrevo/brevo": "^2.5.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.5.3",
    "morgan": "^1.11.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sanitize-html": "2.16.0",
    "sequelize": "^6.37.5",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.5"
  }
}
